# ──────────────────────────────────────────────────────────────
# CareLeap .gitignore
# IMPORTANT: .kiro/ is NEVER ignored. Judges grade what's in it.
# If you ever see .kiro listed here, delete that line.
# ──────────────────────────────────────────────────────────────

# OS clutter
.DS_Store
Thumbs.db

# Secrets — keep real keys out of the repo (mcp.json references env vars)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node / web
node_modules/
web/dist/
web/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Large downloaded datasets — regenerated by `make data`.
# Small committed fixtures live in data/fixtures/ (NOT ignored).
data/raw/
data/cache/
# accidental Explorer/Finder duplicates of the cache (e.g. "data/cache copy/")
data/cache */
*.osm.pbf
*.parquet
!data/fixtures/**

# Build / coverage
dist/
build/
.coverage
htmlcov/
coverage.xml

# Editor
.idea/
*.swp
data/cache copy/

# frozen demo snapshots (rebuild with `make snapshot`)
data/snapshots/
!deploy/snapshot/*.parquet

# unzipped copy of deploy/snapshot/pvta_gtfs.zip (the Docker build unzips its own)
deploy/snapshot/pvta/

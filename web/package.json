{
  "name": "careleap-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test e2e/audit.spec.ts e2e/planner.spec.ts",
    "a11y": "playwright test e2e/a11y.spec.ts",
    "gen:api": "${PYTHON:-python} ../scripts/dump_openapi.py > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "d3-scale": "4.0.2",
    "i18next": "26.5.10",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3-scale": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
